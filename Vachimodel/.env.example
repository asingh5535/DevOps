# Copy to .env (make setup does this) and fill in. Never commit .env.

# --- Model provider keys: only for providers you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Docker Compose
# Database password. Letters and digits only (it's used inside a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Port for the web UI: http://localhost:8100
VACHI_PORT=8100
# Run Ollama inside Docker. Remove this line to use the Ollama app on your Mac instead
# (and set OLLAMA_BASE_URL=http://host.docker.internal:11434).
COMPOSE_PROFILES=ollama
# Local model downloaded automatically on first start.
OLLAMA_MODEL=llama3.2

# --- Optional: require this key for the OpenAI-compatible /v1 API
# VACHI_API_KEY=

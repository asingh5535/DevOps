{
  "title": "Label Compliance — Local",
  "uid": "finops-label-compliance",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["finops", "compliance", "labels"],
  "panels": [
    {
      "id": 1,
      "title": "Deployments Missing Required Labels",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "kube_deployment_labels{label_team='', label_cost_center=''}",
          "legendFormat": "{{namespace}} / {{deployment}}"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    },
    {
      "id": 2,
      "title": "Namespace Label Coverage %",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(kube_namespace_labels{label_team!='',label_cost_center!=''}) / count(kube_namespace_labels) * 100",
          "legendFormat": "Coverage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Pods Missing team Label",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(kube_pod_info) - count(kube_pod_labels{label_team!=''})",
          "legendFormat": "Missing team label"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Pods Missing cost-center Label",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(kube_pod_info) - count(kube_pod_labels{label_cost_center!=''})",
          "legendFormat": "Missing cost-center label"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Label Compliance Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(kube_pod_labels{label_team!='',label_cost_center!=''}) / count(kube_pod_info) * 100",
          "legendFormat": "Compliant pods %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    }
  ]
}

FROM golang:1.24-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

# Copy go.mod only first — go.sum is generated by tidy below
COPY go.mod ./

# Copy full source so tidy can resolve all imports across the 7 connector subpackages
COPY . .

RUN go mod tidy && go mod download

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o okr-compass-api \
    ./cmd/server

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /app/okr-compass-api .

EXPOSE 8080

ENV GIN_MODE=release
ENV PORT=8080

ENTRYPOINT ["./okr-compass-api"]

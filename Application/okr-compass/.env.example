# Copy to .env in this directory before running `docker compose up --build`.
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
# Must be exactly 32 bytes/characters — used for AES-256-GCM encryption of stored cluster credentials.
ENCRYPTION_KEY=change-this-to-a-random-32byte-k
EVAL_INTERVAL_MINUTES=5
